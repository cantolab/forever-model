f_autoSmtPair(string t) =>
    switch t
        "ES1!"    => "NQ1!"
        "NQ1!"    => "ES1!"
        "GC1!"    => "SI1!"
        "SI1!"    => "GC1!"
        "CL1!"    => "RB1!"
        "RB1!"    => "CL1!"
        "6E1!"    => "6B1!"
        "6B1!"    => "6E1!"
        "6A1!"    => "6N1!"
        "6N1!"    => "6A1!"
        "BTC1!"   => "ETH1!"
        "ETH1!"   => "BTC1!"
        "BTCUSD"  => "ETHUSD"
        "ETHUSD"  => "BTCUSD"
        "BTCUSDT" => "ETHUSDT"
        "ETHUSDT" => "BTCUSDT"
        "USDJPY"  => "DXY"
        "USDCHF"  => "DXY"
        "USDCAD"  => "DXY"
        "DXY"     => "USDJPY"
        "EURUSD"  => "GBPUSD"
        "GBPUSD"  => "EURUSD"
        "AUDUSD"  => "NZDUSD"
        "NZDUSD"  => "AUDUSD"
        "AUDCAD"  => "NZDCAD"
        "NZDCAD"  => "AUDCAD"
        "EURCAD"  => "GBPCAD"
        "GBPCAD"  => "EURCAD"
        "EURAUD"  => "GBPAUD"
        "GBPAUD"  => "EURAUD"
        "EURNZD"  => "GBPNZD"
        "GBPNZD"  => "EURNZD"
        "EURJPY"  => "GBPJPY"
        "GBPJPY"  => "EURJPY"
        "AUDJPY"  => "NZDJPY"
        "NZDJPY"  => "AUDJPY"
        "XAUUSD"  => "XAGUSD"
        "XAGUSD"  => "XAUUSD"
        => na

string _autoResult     = f_autoSmtPair(syminfo.ticker)
bool   _smtAutoFound   = autoSMT and not na(_autoResult)
string resolvedSmtPair = _smtAutoFound ? _autoResult : smtPair

resolvedHTF = switch modelType
    "Custom"  => customHTF
    "1m-15m"  => "15"
    "3m-30m"  => "30"
    "5m-1H"   => "60"
    "15m-4H"  => "240"
    "1H-1D"   => "1D"
    "4H-1W"   => "1W"
    "1D-1W"   => "1W"
    "6H-15m"  => "360"
    "90M-5m"  => "90"
    => timeframe.period == "1" ? "15" : timeframe.period == "3" ? "30" : timeframe.period == "5" ? "60" :
       timeframe.period == "15" ? "240" : timeframe.period == "60" ? "1D" : "1W"

resolvedLTF = switch modelType
    "Custom"  => customLTF
    "1m-15m"  => "1"
    "3m-30m"  => "3"
    "5m-1H"   => "5"
    "15m-4H"  => "15"
    "1H-1D"   => "60"
    "4H-1W"   => "240"
    "1D-1W"   => "1D"
    "6H-15m"  => "15"
    "90M-5m"  => "5"
    => timeframe.period

validTF  = timeframe.in_seconds(resolvedHTF) >= timeframe.in_seconds()
cspacer  = timeframe.in_seconds() * 1000
htfMsec  = timeframe.in_seconds(resolvedHTF) * 1000

const int   MAX_FVGS  = 50
const color NO_COLOR  = color.new(color.white, 100)

ls(string s)  => s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid
lsz(string s) => s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

simple string _ceStyleStr    = ceStyle
simple string _erlStyleStr   = erlStyle
simple string _sweepStyleStr = sweepStyle
simple string _smtStyleStr   = smtLineStyle
simple string _obStyleStr    = obStyle
simple string _labelSzStr    = labelSize

f_cleanTicker(string sym) =>
    parts = str.split(sym, ":")
    parts.get(parts.size() - 1)

f_tfLabel(string tf) =>
    string res = tf
    if tf == "1D"
        res := "1D"
    else if tf == "1W"
        res := "1W"
    else
        float mins = str.tonumber(tf)
        if not na(mins)
            if mins < 60
                res := str.tostring(int(mins)) + "m"
            else if mins % 60 == 0
                res := str.tostring(int(mins / 60)) + "H"
            else
                res := str.tostring(mins) + "m"
    res

f_tablePosH(string v, string h) =>
    switch h
        "Left"   => v == "Top" ? position.top_left   : v == "Middle" ? position.middle_left   : position.bottom_left
        "Centre" => v == "Top" ? position.top_center : v == "Middle" ? position.middle_center : position.bottom_center
        =>          v == "Top" ? position.top_right  : v == "Middle" ? position.middle_right  : position.bottom_right

f_timeFilterLabel() =>
    if not enableTimeFilter
        ""
    else
        array<string> sessions = array.new_string()
        if enableFilter1 and str.length(str.trim(filter1Session)) > 0
            sessions.push(str.trim(filter1Session))
        if enableFilter2 and str.length(str.trim(filter2Session)) > 0
            sessions.push(str.trim(filter2Session))
        if enableFilter3 and str.length(str.trim(filter3Session)) > 0
            sessions.push(str.trim(filter3Session))
        if enableFilter4 and str.length(str.trim(filter4Session)) > 0
            sessions.push(str.trim(filter4Session))
        sessions.size() > 0 ? sessions.join(" | ") : ""

f_dashTz() =>
    if useCustomTimezone
        string sign = timezoneHours >= 0 ? "+" : "-"
        string hh   = str.tostring(math.abs(timezoneHours))
        string mm   = timezoneMinutes < 10 ? "0" + str.tostring(timezoneMinutes) : str.tostring(timezoneMinutes)
        "UTC" + sign + hh + (timezoneMinutes != 0 ? ":" + mm : "")
    else
        syminfo.timezone

f_inSession(string sess) =>
    not na(time(timeframe.period, sess, f_dashTz()))

f_timeFilterActive() =>
    if not enableTimeFilter
        true
    else
        bool any = false
        if enableFilter1 and str.length(str.trim(filter1Session)) > 0 and f_inSession(filter1Session)
            any := true
        if enableFilter2 and str.length(str.trim(filter2Session)) > 0 and f_inSession(filter2Session)
            any := true
        if enableFilter3 and str.length(str.trim(filter3Session)) > 0 and f_inSession(filter3Session)
            any := true
        if enableFilter4 and str.length(str.trim(filter4Session)) > 0 and f_inSession(filter4Session)
            any := true
        any

var string s1Ticker = na
var string s2Ticker = na

var float[] obProjections = array.new<float>()
var float   _maxProj      = na

if barstate.isfirst
    s1Ticker := f_cleanTicker(resolvedSmtPair)
    s2Ticker := f_cleanTicker(smtPair2)
    for part in str.split(str.replace_all(obProjInput, " ", ""), ",")
        v = str.tonumber(part)
        if not na(v)
            obProjections.push(v)
    if obProjections.size() > 0
        _maxProj := obProjections.get(0)
        for k = 1 to obProjections.size() - 1
            _maxProj := math.max(_maxProj, obProjections.get(k))

htfPivotH() =>
    var float v = na
    p = ta.pivothigh(high, 1, 1)
    if not na(p)
        v := p
    v

htfPivotL() =>
    var float v = na
    p = ta.pivotlow(low, 1, 1)
    if not na(p)
        v := p
    v

findPrice(float price, int t0, bool useHigh) =>
    int result = t0
    int span   = (time - t0) / cspacer
    if span > 0 and span < 5000
        for j = 0 to span
            if (useHigh ? high[j] : low[j]) == price
                result := time[j]
                break
    result

f_smtFindPrice(float price, int t0, bool useHigh) =>
    int result = t0
    int span   = math.min((time - t0) / cspacer, 500)
    if span > 0
        for j = 0 to span
            int lt = time[j]
            if lt < t0
                break
            float p = useHigh ? high[j] : low[j]
            if lt < t0 + htfMsec and p == price
                result := lt
                break
    result

f_findExtremeBar(float price, int t0, bool useHigh) =>
    int result = t0
    int span   = math.min((time - t0) / cspacer, 5000)
    if span > 0
        for j = span to 0
            int lt = time[j]
            if lt >= t0
                float p = useHigh ? high[j] : low[j]
                if p == price
                    result := lt
                    break
    result

